{
  "_note": "v10 (required baseline 2, multi-task CNN): one ResNet-50 backbone with two linear heads (crop 55, disease 175) trained jointly, loss = CE(crop) + CE(disease). Everything else identical to v9 (augmentation, optimiser, validation, pair-score composition, gamma calibration), so v9 vs v10 isolates independent vs shared backbone.",
  "_result": "Pending.",
  "version": "v10",
  "method": "cnn_multitask",
  "seed": 42,
  "data": {
    "_note": "Same as v9.",
    "eval_splits": [
      "test_seen",
      "test_unseen"
    ],
    "label_space": "all_pairs"
  },
  "model": {
    "_note": "Same as v9.",
    "backbone": "resnet50",
    "pretrained": true,
    "head_dropout": 0.3
  },
  "input": {
    "_note": "Same as v9.",
    "resize_cache": 256,
    "resize": 256,
    "crop_size": 224
  },
  "augmentation": {
    "_note": "Same as v9.",
    "random_resized_crop_scale": [
      0.25,
      1.0
    ],
    "horizontal_flip_p": 0.5,
    "vertical_flip_p": 0.5,
    "color_jitter": {
      "brightness": 0.2,
      "contrast": 0.2,
      "saturation": 0.2,
      "hue": 0.0
    }
  },
  "loss": {
    "_note": "Same as v9: CE + label smoothing 0.1; the crop and disease losses are summed with equal weight 1.0.",
    "label_smoothing": 0.1,
    "weights": {
      "crop": 1.0,
      "disease": 1.0
    }
  },
  "optimizer": {
    "_note": "Same as v9.",
    "lr_backbone": 0.0001,
    "lr_head": 0.001,
    "weight_decay": 0.05
  },
  "validation": {
    "_note": "Same as v9.",
    "exclude_holdout_diseases": [
      "healthy"
    ],
    "n_holdout_pairs": 20,
    "min_holdout_images": 8,
    "val_fraction": 0.15,
    "gamma_grid": [
      0.0,
      10.0,
      0.1
    ],
    "exclude_real_unseen_from_label_space": true,
    "max_images_per_holdout_pair": 40,
    "n_splits": 3
  },
  "training": {
    "_note": "Same as v9.",
    "batch_size": 32,
    "max_epochs": 20,
    "final_fit": "all_train"
  },
  "evaluation": {
    "_note": "Same as v9.",
    "top_k": [
      1,
      5
    ]
  },
  "runtime": {
    "_note": "Same as v9.",
    "device": "cuda",
    "amp": true,
    "num_workers": 4
  },
  "output_dir": "runs/v10"
}