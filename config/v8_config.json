      "ceroplastes_rubens": "red wax scale insects",
      "aulacaspis_tubercularis": "white mango scale insects",
      "ischnaspis_longirostris": "black thread scale insects",
      "procontarinia_matteiana": "mango leaf gall midge galls",
      "procontarinia_rubus": "gall midge galls",
      "erosomyia_sp": "gall midge damage",
      "venturia_inaequalis": "apple scab",
      "gnomonia_leptostyla": "walnut anthracnose",
      "erwinia_amylovora": "erwinia fire blight",
      "aculus_olearius": "olive bud mites",
      "cisaberoptus_kenyae": "leaf coating mites",
      "dialeuropora_decempuncta": "whiteflies",
      "neomelicharia_sparsa": "planthoppers",
      "valanga_nigricornis": "grasshopper feeding damage",
      "mictis_longicornis": "leaf-footed bug damage",
      "apoderus_javanicus": "leaf-rolling weevil damage",
      "orthaga_euadrusalis": "leaf webber caterpillars",
      "dappula_tertia": "bagworms",
      "diabrotica_speciosa": "cucumber beetle feeding damage"
    }
  },
  "prompts": {
    "_note": "Unchanged from v6.",
    "descriptions_file": "knowledge/disease_descriptions_v1.json",
    "pair_template": "a photo of {crop} leaves with {disease}: {description}.",
    "crop_template": "a photo of {crop} leaves.",
    "disease_template": "a photo of leaves with {disease}: {description}."
  },
  "validation": {
    "_note": "Unchanged from v6.",
    "exclude_holdout_diseases": [
      "healthy"
    ],
    "n_holdout_pairs": 20,
    "min_holdout_images": 8,
    "val_fraction": 0.15,
    "gamma_grid": [
