{
  "_note": "v10: v9 + 336 px input resolution. Ablation of ONE change against v9 (everything else identical, same validation split: seed 42, 1 split). Keep the change only if validation HM beats v9's 51.2% by more than 2 points (v11 measured run-to-run noise of about 3 points: v9 retrained on the same split scored 48.3% vs 51.2%); the test result is recorded but must not decide.",
  "_result": "Pending.",
  "version": "v10",
  "method": "clip_prompt_lora",
  "seed": 42,
  "data": {
    "_note": "Unchanged from v9.",
    "eval_splits": [
      "test_seen",
      "test_unseen"
    ],
    "label_space": "all_pairs"
  },
  "model": {
    "_note": "v9 + input resolution 224 -> 336. open_clip interpolates the pretrained position embeddings from the 14x14 to the 21x21 patch grid. Motivation: 71% of v9's seen errors are right crop / wrong disease, often fine lesion detail lost when 3120 px photos are shrunk to 224.",
    "library": "open_clip",
    "arch": "ViT-B-16-quickgelu",
    "pretrained": "openai",
    "image_size": 336
  },
  "image_encoder": {
    "_note": "Unchanged from v9.",
    "lora": {
      "last_n_blocks": 4,
      "rank": 8,
      "alpha": 16,
      "targets": [
        "attn_qkv",
        "attn_out",
        "mlp_in",
        "mlp_out"
      ],
      "lr": 0.0001
    }
  },
  "input": {
    "_note": "Resize cache 256 -> 384 px (it must be at least the 336 px input; a separate cache folder, runs/cache/resized_384) and crops at 336. Same augmentation and test transform otherwise.",
    "resize_cache": 384,
    "crop_size": 336
  },
  "augmentation": {
    "_note": "Unchanged from v9.",
    "random_resized_crop_scale": [
      0.5,
      1.0
    ],
    "horizontal_flip_p": 0.5,
    "vertical_flip_p": 0.5,
    "color_jitter": {
      "brightness": 0.2,
      "contrast": 0.2,
      "saturation": 0.2,
      "hue": 0.0
    }
  },
  "names": {
    "_note": "Unchanged from v9.",
    "underscore_to_space": true,
    "crop_overrides": {
      "pepper_bell": "bell pepper",
      "paddy": "rice",
      "blackgram": "black gram"
    },
    "disease_overrides": {
      "xamthomonas": "xanthomonas bacterial blight",
      "verticulium_wilt": "verticillium wilt",
      "crinckle": "crinkle",
      "monillia_laxa": "monilinia brown rot",
      "leafblast": "leaf blast",
      "die_back": "dieback",
      "gray_light": "gray blight",
      "curl": "leaf curl",
      "viral": "viral disease",
      "miner": "leaf miner damage",
      "slug": "slug feeding damage",
      "caterpillar": "caterpillar feeding damage",
      "insects_damages": "insect damage",
      "nutrition_deficiency": "nutrient deficiency",
      "scorch": "leaf scorch",
      "pox_virus": "plum pox virus",
      "pocket_disease": "plum pocket disease",
      "cercospora": "cercospora leaf spot",
      "tungro": "tungro virus",
      "hispa": "rice hispa beetle damage",
      "aphis_spp": "aphids",
      "eriosoma_lanigerum": "woolly apple aphids",
      "icerya_seychellarum": "fluted scale insects",
      "parthenolecanium_corni": "lecanium scale insects",
      "ceroplastes_rubens": "red wax scale insects",
      "aulacaspis_tubercularis": "white mango scale insects",
      "ischnaspis_longirostris": "black thread scale insects",
      "procontarinia_matteiana": "mango leaf gall midge galls",
      "procontarinia_rubus": "gall midge galls",
      "erosomyia_sp": "gall midge damage",
      "venturia_inaequalis": "apple scab",
      "gnomonia_leptostyla": "walnut anthracnose",
      "erwinia_amylovora": "erwinia fire blight",
      "aculus_olearius": "olive bud mites",
      "cisaberoptus_kenyae": "leaf coating mites",
      "dialeuropora_decempuncta": "whiteflies",
      "neomelicharia_sparsa": "planthoppers",
      "valanga_nigricornis": "grasshopper feeding damage",
      "mictis_longicornis": "leaf-footed bug damage",
      "apoderus_javanicus": "leaf-rolling weevil damage",
      "orthaga_euadrusalis": "leaf webber caterpillars",
      "dappula_tertia": "bagworms",
      "diabrotica_speciosa": "cucumber beetle feeding damage"
    }
  },
  "prompts": {
    "_note": "Unchanged from v9.",
    "descriptions_file": "knowledge/disease_descriptions_v1.json",
    "pair_template": "a photo of {crop} leaves with {disease}: {description}.",
    "crop_template": "a photo of {crop} leaves.",
    "disease_template": "a photo of leaves with {disease}: {description}."
  },
  "validation": {
    "_note": "Unchanged from v9.",
    "exclude_holdout_diseases": [
      "healthy"
    ],
    "n_holdout_pairs": 20,
    "min_holdout_images": 8,
    "val_fraction": 0.15,
    "gamma_grid": [
      0.0,
      0.1,
      0.0025
    ],
    "exclude_real_unseen_from_label_space": true,
    "max_images_per_holdout_pair": 40,
    "n_splits": 1
  },
  "training": {
    "_note": "Unchanged from v9.",
    "lr": 0.0002,
    "weight_decay": 0.0,
    "batch_size": 64,
    "max_epochs": 15,
    "logit_scale": 100.0,
    "loss_weights": {
      "pair": 1.0,
      "crop": 0.5,
      "disease": 0.5
    },
    "final_fit": "all_train"
  },
  "evaluation": {
    "_note": "Unchanged from v9.",
    "top_k": [
      1,
      5
    ]
  },
  "runtime": {
    "_note": "Gradient checkpointing also on the image encoder so batch 64 fits at 336 px (2.25x more patches). It recomputes activations in the backward pass: same maths, slower, so batch size is NOT a second variable.",
    "device": "cuda",
    "amp": true,
    "grad_checkpointing": true,
    "num_workers": 4,
    "grad_checkpointing_image": true
  },
  "output_dir": "runs/vlm/v10"
}