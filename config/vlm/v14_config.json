{
  "_note": "v14: v9 + class-balanced (square-root) sampling. Ablation of ONE change against v9 (everything else identical, same validation split: seed 42, 1 split). Keep the change only if validation HM beats v9's 51.2% by more than 2 points (v11 measured run-to-run noise of about 3 points: v9 retrained on the same split scored 48.3% vs 51.2%); the test result is recorded but must not decide.",
  "_result": "Not kept (excluded from v15): validation HM 49.0% (epoch 9, gamma 0.0725) vs v9's 51.2%, -2.2 points; from epoch 10 on it stayed about 2 points below v9 every epoch, so it is a consistent effect, not noise in one epoch. Test (recorded, not used for the decision): HM 62.3% top-1 / 91.4% top-5 (v9 65.1% / 92.1%); seen 49.6%, unseen 83.8%; per-class mean seen top-1 33.5% (v9 33.4%). Likely reason: square-root balancing draws pairs with 5 or fewer training images about 4x more often (16.7% vs 4.5% of draws), so the model repeats the same few photos of rare pairs rather than seeing new ones, while the common pairs that make up most test images (and 55% of v9's seen errors) get less training.",
  "version": "v14",
  "method": "clip_prompt_lora",
  "seed": 42,
  "data": {
    "_note": "Unchanged from v9.",
    "eval_splits": [
      "test_seen",
      "test_unseen"
    ],
    "label_space": "all_pairs"
  },
  "model": {
    "_note": "Unchanged from v9.",
    "library": "open_clip",
    "arch": "ViT-B-16-quickgelu",
    "pretrained": "openai"
  },
  "image_encoder": {
    "_note": "Unchanged from v9.",
    "lora": {
      "last_n_blocks": 4,
      "rank": 8,
      "alpha": 16,
      "targets": [
        "attn_qkv",
        "attn_out",
        "mlp_in",
        "mlp_out"
      ],
      "lr": 0.0001
    }
  },
  "input": {
    "_note": "Unchanged from v9.",
    "resize_cache": 256,
    "crop_size": 224
  },
  "augmentation": {
    "_note": "Unchanged from v9.",
    "random_resized_crop_scale": [
      0.5,
      1.0
    ],
    "horizontal_flip_p": 0.5,
    "vertical_flip_p": 0.5,
    "color_jitter": {
      "brightness": 0.2,
      "contrast": 0.2,
      "saturation": 0.2,
      "hue": 0.0
    }
  },
  "names": {
    "_note": "Unchanged from v9.",
    "underscore_to_space": true,
    "crop_overrides": {
      "pepper_bell": "bell pepper",
      "paddy": "rice",
      "blackgram": "black gram"
    },
    "disease_overrides": {
      "xamthomonas": "xanthomonas bacterial blight",
      "verticulium_wilt": "verticillium wilt",
      "crinckle": "crinkle",
      "monillia_laxa": "monilinia brown rot",
      "leafblast": "leaf blast",
      "die_back": "dieback",
      "gray_light": "gray blight",
      "curl": "leaf curl",
      "viral": "viral disease",
      "miner": "leaf miner damage",
      "slug": "slug feeding damage",
      "caterpillar": "caterpillar feeding damage",
      "insects_damages": "insect damage",
      "nutrition_deficiency": "nutrient deficiency",
      "scorch": "leaf scorch",
      "pox_virus": "plum pox virus",
      "pocket_disease": "plum pocket disease",
      "cercospora": "cercospora leaf spot",
      "tungro": "tungro virus",
      "hispa": "rice hispa beetle damage",
      "aphis_spp": "aphids",
      "eriosoma_lanigerum": "woolly apple aphids",
      "icerya_seychellarum": "fluted scale insects",
      "parthenolecanium_corni": "lecanium scale insects",
      "ceroplastes_rubens": "red wax scale insects",
      "aulacaspis_tubercularis": "white mango scale insects",
      "ischnaspis_longirostris": "black thread scale insects",
      "procontarinia_matteiana": "mango leaf gall midge galls",
      "procontarinia_rubus": "gall midge galls",
      "erosomyia_sp": "gall midge damage",
      "venturia_inaequalis": "apple scab",
      "gnomonia_leptostyla": "walnut anthracnose",
      "erwinia_amylovora": "erwinia fire blight",
      "aculus_olearius": "olive bud mites",
      "cisaberoptus_kenyae": "leaf coating mites",
      "dialeuropora_decempuncta": "whiteflies",
      "neomelicharia_sparsa": "planthoppers",
      "valanga_nigricornis": "grasshopper feeding damage",
      "mictis_longicornis": "leaf-footed bug damage",
      "apoderus_javanicus": "leaf-rolling weevil damage",
      "orthaga_euadrusalis": "leaf webber caterpillars",
      "dappula_tertia": "bagworms",
      "diabrotica_speciosa": "cucumber beetle feeding damage"
    }
  },
  "prompts": {
    "_note": "Unchanged from v9.",
    "descriptions_file": "knowledge/disease_descriptions_v1.json",
    "pair_template": "a photo of {crop} leaves with {disease}: {description}.",
    "crop_template": "a photo of {crop} leaves.",
    "disease_template": "a photo of leaves with {disease}: {description}."
  },
  "validation": {
    "_note": "Unchanged from v9.",
    "exclude_holdout_diseases": [
      "healthy"
    ],
    "n_holdout_pairs": 20,
    "min_holdout_images": 8,
    "val_fraction": 0.15,
    "gamma_grid": [
      0.0,
      0.1,
      0.0025
    ],
    "exclude_real_unseen_from_label_space": true,
    "max_images_per_holdout_pair": 40,
    "n_splits": 1
  },
  "training": {
    "_note": "v9 + class-balanced sampling: each training image is drawn with weight n_pair^-0.5 (square-root balancing: rare pairs are seen more often, but not as often as full balancing, which would repeat 1-image pairs hundreds of times per epoch). Epoch size unchanged. Motivation: pairs with 1-5 training images reach only 22-35% seen top-1 in v9.",
    "lr": 0.0002,
    "weight_decay": 0.0,
    "batch_size": 64,
    "max_epochs": 15,
    "logit_scale": 100.0,
    "loss_weights": {
      "pair": 1.0,
      "crop": 0.5,
      "disease": 0.5
    },
    "final_fit": "all_train",
    "sampling": {
      "type": "class_balanced",
      "power": 0.5
    }
  },
  "evaluation": {
    "_note": "Unchanged from v9.",
    "top_k": [
      1,
      5
    ]
  },
  "runtime": {
    "_note": "Unchanged from v9.",
    "device": "cuda",
    "amp": true,
    "grad_checkpointing": true,
    "num_workers": 4
  },
  "output_dir": "runs/vlm/v14"
}