{
  "_note": "v5.3: v5 + more LoRA capacity (8 blocks, rank 16). Ablation of ONE change against v5 (everything else identical, same validation split: seed 42, 1 split). Keep the change only if validation HM beats v5's 51.2% by more than 2 points (v6 measured run-to-run noise of about 3 points: v5 retrained on the same split scored 48.3% vs 51.2%); the test result is recorded but must not decide.",
  "_result": "Qualifies for v5.5 on validation: val HM 56.9% (epoch 6, gamma 0.075) vs v5's 51.2% (+5.7 points, above the 2-point margin); every validation epoch from 3 on beat v5's best, so the gain is not one lucky epoch. Larger adapters learn faster and overfit sooner: val HM peaked at epochs 6-9 and gamma kept rising (0.055 -> 0.09). Test does NOT show the same gain in the headline metric: HM 64.5% top-1 / 92.1% top-5 vs v5's 65.1% / 92.1%; seen 52.2% (v5 53.4%), unseen 84.3% (v5 83.2%). The validation-test gap is a reminder that single-run validation differences carry noise. Where it clearly differs is uncalibrated behaviour: unseen top-1 at gamma 0 is 28.7% (v5 16.2%), uncalibrated HM 40.3% (v5 26.1%), and unseen DISEASE accuracy at gamma 0 is 32.3%, the best of any model so far (v5 21.1%, v4 30.9%, CNN baseline 14.8%). So more LoRA capacity (with the earlier epoch) reduced the seen-pair bias and improved disease transfer to new crops, but after calibration the harmonic mean ends up the same as v5.",
  "version": "v5.3",
  "title": "lora_large",
  "method": "clip_prompt_lora",
  "seed": 42,
  "data": {
    "_note": "Unchanged from v5.",
    "eval_splits": [
      "test_seen",
      "test_unseen"
    ],
    "label_space": "all_pairs"
  },
  "model": {
    "_note": "Unchanged from v5.",
    "library": "open_clip",
    "arch": "ViT-B-16-quickgelu",
    "pretrained": "openai"
  },
  "image_encoder": {
    "_note": "v5 + more LoRA capacity: last 8 blocks instead of 4, rank 16 instead of 8. alpha 16 -> 32 keeps the LoRA scale (alpha/rank) at 2, so only capacity changes, not the effective step size. About 4x more adapter parameters (1.57M vs 393k). Same lr.",
    "lora": {
      "last_n_blocks": 8,
      "rank": 16,
      "alpha": 32,
      "targets": [
        "attn_qkv",
        "attn_out",
        "mlp_in",
        "mlp_out"
      ],
      "lr": 0.0001
    }
  },
  "input": {
    "_note": "Unchanged from v5.",
