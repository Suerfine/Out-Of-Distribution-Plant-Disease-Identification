<mxfile host="drawio"><diagram name="VLM pipeline"><mxGraphModel adaptiveColors="auto" grid="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;VLM pipeline (v5.5): CLIP ViT-B/16 + compositional prompt vectors + LoRA on the image encoder&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:13px&#x27;&gt;Every operation in setup, training, model selection and prediction. Ids are referenced by docs/vlm_improvement_analysis.md. Tags under a box = experiments already run on that operation (validation HM change vs its base; keep only if more than +2 points).&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1878" height="60" as="geometry"/></mxCell><mxCell id="g1" value="Legend" style="swimlane;startSize=24;html=1;fontSize=13;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1878" height="100" as="geometry"/></mxCell><mxCell id="lg0" value="operation (no weights)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g1"><mxGeometry x="20" y="32" width="260" height="30" as="geometry"/></mxCell><mxCell id="lg1" value="frozen pretrained CLIP weights" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g1"><mxGeometry x="320" y="32" width="260" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="TRAINABLE parameters" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="g1"><mxGeometry x="620" y="32" width="260" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="data / cache / saved file" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g1"><mxGeometry x="920" y="32" width="260" height="30" as="geometry"/></mxCell><mxCell id="lg4" value="loss term" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g1"><mxGeometry x="1220" y="32" width="260" height="30" as="geometry"/></mxCell><mxCell id="lg5" value="selection" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="g1"><mxGeometry x="1520" y="32" width="260" height="30" as="geometry"/></mxCell><mxCell id="lt0" value="tried, not kept" style="rounded=1;arcSize=40;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g1"><mxGeometry x="20" y="70" width="260" height="20" as="geometry"/></mxCell><mxCell id="lt1" value="tried, kept" style="rounded=1;arcSize=40;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g1"><mxGeometry x="320" y="70" width="260" height="20" as="geometry"/></mxCell><mxCell id="lt2" value="running now" style="rounded=1;arcSize=40;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g1"><mxGeometry x="620" y="70" width="260" height="20" as="geometry"/></mxCell><mxCell id="ltx" value="solid arrow = data flow; dashed purple = parameter update; dashed grey = per-epoch / control" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="g1"><mxGeometry x="920" y="70" width="700" height="20" as="geometry"/></mxCell><mxCell id="g2" value="A. Offline data preparation (once)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#f1f8e9;swimlaneFillColor=#f1f8e9;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1878" height="186" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;A1 Read DPD-Small CSVs&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;8,000 train / 2,000 test-seen / 1,448 test-unseen; file-name source prefix never used&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g2"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;A2 Resize cache&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;shorter side 256 px, saved JPEG q95 in runs/cache/resized_256 (shared with the CNNs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g2"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="A3" value="&lt;b&gt;A3 Pair table&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;333 pairs = 323 seen + 10 unseen (ids interleaved); pair = (crop of 55, disease of 175)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g2"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="A4" value="&lt;b&gt;A4 Validation split&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;seed 42: 20 whole seen pairs (8+ imgs, cap 40, not healthy) held out as pseudo-unseen; 15% of the rest = val-seen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g2"><mxGeometry x="722" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="A5" value="&lt;b&gt;A5 fit / val-seen / pseudo-unseen&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;crop and disease of every held-out pair still occur in the fit set&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g2"><mxGeometry x="956" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="g7" value="B. Text-side setup (once per model build; dpd/prompt_learner.py)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#f3e5f5;swimlaneFillColor=#f3e5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="1878" height="186" as="geometry"/></mxCell><mxCell id="B1" value="&lt;b&gt;B1 Clean names&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;underscore to space; ~45 overrides (paddy = rice, xamthomonas = xanthomonas bacterial blight)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g7"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="B2" value="&lt;b&gt;B2 Symptom descriptions&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;1 short visual description per disease (knowledge/disease_descriptions_v1.json, unverified)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g7"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="B3" value="&lt;b&gt;B3 Fill 3 templates&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;pair: a photo of x leaves with x: {desc}. / crop: a photo of x leaves. / disease: a photo of leaves with x: {desc}.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g7"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="B4" value="&lt;b&gt;B4 Tokenise (BPE)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;77-token context (error if longer); placeholder x = 1 token; cut after EOT (exact under causal mask)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g7"><mxGeometry x="722" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="B5" value="&lt;b&gt;B5 Token embeddings&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;frozen token_embedding lookup, precomputed per group (333 / 55 / 175 sentences)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g7"><mxGeometry x="956" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="B6" value="&lt;b&gt;B6 Crop and disease vectors&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;55 + 175 vectors x 512, initialised as the mean token embedding of each name&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="g7"><mxGeometry x="1190" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="t13" value="v8 contrastive rewrites (33 diseases)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g7"><mxGeometry x="254" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="t14" value="v3.x prompt-text variants (zero-shot)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g7"><mxGeometry x="254" y="161" width="200" height="20" as="geometry"/></mxCell><mxCell id="g15" value="C. Image encoder forward (every training step; batch 64; AMP fp16)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#e3f2fd;swimlaneFillColor=#e3f2fd;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="1878" height="186" as="geometry"/></mxCell><mxCell id="C1" value="&lt;b&gt;C1 Sample batch&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;uniform shuffle of fit images, drop_last; 4 DataLoader workers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g15"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="C2" value="&lt;b&gt;C2 Augment&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;RandomResizedCrop 224, scale 0.5-1, bicubic; h-flip 0.5, v-flip 0.5; jitter b/c/s 0.2, hue 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g15"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="C3" value="&lt;b&gt;C3 Normalise&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;to float, CLIP mean / std&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g15"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="C4" value="&lt;b&gt;C4 Patch embed&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;16x16 conv: 14x14 = 196 patch tokens + CLS token + positional emb, ln_pre&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g15"><mxGeometry x="722" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="C5" value="&lt;b&gt;C5 ViT blocks 1-4&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;frozen self-attention + MLP (QuickGELU), width 768, 12 heads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g15"><mxGeometry x="956" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="C6" value="&lt;b&gt;C6 ViT blocks 5-12 + LoRA&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;W + (32/16) B A on qkv, attn-out, mlp-in, mlp-out; rank 16; B = 0 at start; 1.57M params&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="g15"><mxGeometry x="1190" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="C7" value="&lt;b&gt;C7 Pool CLS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;ln_post on the CLS token; patch tokens discarded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g15"><mxGeometry x="1424" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="C8" value="&lt;b&gt;C8 Project + L2 norm&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;visual.proj 768 to 512; unit-length image embedding v&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g15"><mxGeometry x="1658" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="t23" value="v5.4 class-balanced sampler: -2.2" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g15"><mxGeometry x="20" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="t24" value="v7.1 zoom crops 0.25-1: -1.6" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g15"><mxGeometry x="254" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="t25" value="v5.1 336 px input: -0.2" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g15"><mxGeometry x="254" y="161" width="200" height="20" as="geometry"/></mxCell><mxCell id="t26" value="v5.3 8 blocks, rank 16: +5.7 KEPT" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g15"><mxGeometry x="1190" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="t27" value="v7 + patch-token disease score: +1.5" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g15"><mxGeometry x="1424" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="g28" value="D. Text encoder forward (every training step; differentiable w.r.t. the vectors only)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#f3e5f5;swimlaneFillColor=#f3e5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="818" width="1878" height="186" as="geometry"/></mxCell><mxCell id="D1" value="&lt;b&gt;D1 Substitute vectors&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;write each crop / disease vector into its sentence&#x27;s placeholder slot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g28"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="D2" value="&lt;b&gt;D2 Add positional emb&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;frozen positional embedding (truncated length)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g28"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="D3" value="&lt;b&gt;D3 Text transformer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;12 frozen layers, causal mask, width 512; gradient checkpointing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g28"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="D4" value="&lt;b&gt;D4 ln_final, EOT token&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;hidden state at the EOT position&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g28"><mxGeometry x="722" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="D5" value="&lt;b&gt;D5 Project + L2 norm&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;text_projection 512 to 512; unit-length&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="g28"><mxGeometry x="956" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="D6" value="&lt;b&gt;D6 Text embeddings&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;T_pair 333x512, T_crop 55x512, T_dis 175x512 (recomputed every step)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g28"><mxGeometry x="1190" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="g34" value="E. Scoring, losses and optimisation (train/train_lora.py fit)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#ffebee;swimlaneFillColor=#ffebee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1024" width="1878" height="332" as="geometry"/></mxCell><mxCell id="E1" value="&lt;b&gt;E1 Cosine scores&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;v T_pair restricted to TRAINED pair columns (unseen, pseudo-unseen get no gradient); v T_crop; v T_dis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g34"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E2" value="&lt;b&gt;E2 Temperature&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;x logit scale 100 (fixed, CLIP&#x27;s value)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g34"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E3" value="&lt;b&gt;E3 Pair CE (w 1.0)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;softmax over the ~300 trained pairs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g34"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E4" value="&lt;b&gt;E4 Crop CE (w 0.5)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;softmax over 55 crop prompts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g34"><mxGeometry x="722" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E5" value="&lt;b&gt;E5 Disease CE (w 0.5)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;softmax over 175 disease prompts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g34"><mxGeometry x="956" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E6" value="&lt;b&gt;E6 Weighted sum&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;L = 1.0 pair + 0.5 crop + 0.5 disease&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g34"><mxGeometry x="1190" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E7" value="&lt;b&gt;E7 Backward&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;AMP; gradients through the frozen encoders into vectors + LoRA only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g34"><mxGeometry x="1424" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E8" value="&lt;b&gt;E8 AdamW step&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;vectors lr 2e-4, LoRA lr 1e-4, weight decay 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="g34"><mxGeometry x="1658" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="E9" value="&lt;b&gt;E9 Cosine LR schedule&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;per step, no warm-up; max 15 epochs, ~125 steps / epoch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g34"><mxGeometry x="1658" y="186" width="200" height="96" as="geometry"/></mxCell><mxCell id="t45" value="v7.2 + within-crop pair CE: -0.5" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g34"><mxGeometry x="488" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="g46" value="F. Stage 1: model selection on validation (after every epoch)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#fffde7;swimlaneFillColor=#fffde7;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1376" width="1878" height="186" as="geometry"/></mxCell><mxCell id="F1" value="&lt;b&gt;F1 Encode validation&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;val-seen + pseudo-unseen; test transform: resize 224 + centre crop, no augmentation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g46"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="F2" value="&lt;b&gt;F2 Score 333 pairs&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;cosine vs T_pair; the real 10 unseen pairs masked to -1e9&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g46"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="F3" value="&lt;b&gt;F3 Gamma sweep&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;subtract gamma 0 to 0.1 (step 0.0025) from the SEEN-pair scores&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g46"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="F4" value="&lt;b&gt;F4 Harmonic mean&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;HM of val-seen top-1 and pseudo-unseen top-1, per gamma&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g46"><mxGeometry x="722" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="F5" value="&lt;b&gt;F5 Pick epoch, gamma&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;argmax HM over 15 epochs x 41 gammas (one split)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="g46"><mxGeometry x="956" y="40" width="200" height="110" as="geometry"/></mxCell><mxCell id="t51" value="v5.2 flip TTA: +0.4" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g46"><mxGeometry x="20" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="t52" value="per-pair calibration: rejected" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g46"><mxGeometry x="488" y="139" width="200" height="20" as="geometry"/></mxCell><mxCell id="g53" value="G. Stage 2: refit and save" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#f1f8e9;swimlaneFillColor=#f1f8e9;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1592" width="1878" height="186" as="geometry"/></mxCell><mxCell id="G1" value="&lt;b&gt;G1 Fresh model&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;rebuild B6 + C6 from scratch, same seed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g53"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="G2" value="&lt;b&gt;G2 Refit on all train&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;all 8,000 images and 323 seen pairs, for the selected number of epochs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g53"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="G3" value="&lt;b&gt;G3 Saved run&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;prompt_vectors.pt, lora_image_encoder.pt, pair_text_embeddings.npy, gamma, metrics.json, scores.npz&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g53"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="g56" value="H. Prediction: test evaluation and the Streamlit app (dpd/inference.py)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;fillColor=#e8f5e9;swimlaneFillColor=#e8f5e9;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1798" width="1878" height="332" as="geometry"/></mxCell><mxCell id="H1" value="&lt;b&gt;H1 Input image&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;upload or test image (jpg / png, converted to RGB)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g56"><mxGeometry x="20" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H2" value="&lt;b&gt;H2 Standardise&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;downscale to 256 + JPEG q95 round trip (what training saw)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g56"><mxGeometry x="254" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H3" value="&lt;b&gt;H3 Test transform&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;resize 224 bicubic, centre crop 224, normalise&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g56"><mxGeometry x="488" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H4" value="&lt;b&gt;H4 Image encoder + LoRA&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;C4-C8 with the saved adapters: v (512)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="g56"><mxGeometry x="722" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H5" value="&lt;b&gt;H5 Score 333 pairs&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;v x cached T_pair (text encoder not run at test time)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g56"><mxGeometry x="956" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H6" value="&lt;b&gt;H6 Calibrate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;subtract gamma (0.075) from the 323 seen pairs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g56"><mxGeometry x="1190" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H7" value="&lt;b&gt;H7 Rank: top-1 / top-5&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;predicted pair, hence crop + disease&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g56"><mxGeometry x="1424" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H8" value="&lt;b&gt;H8 Confidence&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;softmax(100 x scores) over all 333 pairs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g56"><mxGeometry x="1658" y="40" width="200" height="96" as="geometry"/></mxCell><mxCell id="H9" value="&lt;b&gt;H9 Train bank&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;image embeddings of all 8,000 training images (cached by the app)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;size=10;" vertex="1" parent="g56"><mxGeometry x="722" y="186" width="200" height="96" as="geometry"/></mxCell><mxCell id="H10" value="&lt;b&gt;H10 Retrieve neighbours&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;cosine kNN of v in the train bank, plus same-crop / same-disease images&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g56"><mxGeometry x="956" y="186" width="200" height="96" as="geometry"/></mxCell><mxCell id="H11" value="&lt;b&gt;H11 Optional ensemble (v6.x)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;w log_softmax(CLIP) + (1-w) log P(CNN pair); w, gamma chosen on validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g56"><mxGeometry x="1190" y="186" width="200" height="96" as="geometry"/></mxCell><mxCell id="H12" value="&lt;b&gt;H12 Evaluate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;top-1/5 seen and unseen, HM, crop / disease acc, 323x333 seen confusion matrix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g56"><mxGeometry x="1424" y="186" width="200" height="96" as="geometry"/></mxCell><mxCell id="t69" value="v6 + CNN ensemble: +1.8 (v6.1, v6.2 runs)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g56"><mxGeometry x="1190" y="285" width="200" height="20" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#555555;" edge="1" parent="g2" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#555555;" edge="1" parent="g2" source="A2" target="A3"><mxGeometry relative="1" as=