<mxfile><diagram name="fig01_pipeline"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;The VLM pipeline: one image is scored against 333 crop-disease prompts&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Plant photo&lt;/b&gt;&lt;br&gt;224 x 224 pixels" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="150" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;LoRA adapters&lt;/b&gt; in blocks 5-12&lt;br&gt;1.57M numbers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="240" y="170" width="230" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;CLIP image encoder&lt;/b&gt; ViT-B/16&lt;br&gt;12 blocks, 86M weights" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;" vertex="1" parent="1"><mxGeometry x="240" y="80" width="230" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Image embedding v&lt;/b&gt;&lt;br&gt;512 numbers, length 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;333 pair prompts&lt;/b&gt;&lt;br&gt;[CTX] [CTX] [CTX] [CROP] leaves with [DISEASE]: symptoms." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="150" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Learned word vectors&lt;/b&gt;&lt;br&gt;55 crops + 175 diseases&lt;br&gt;+ 3 context vectors (CoOp)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="240" y="240" width="230" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;CLIP text encoder&lt;/b&gt;&lt;br&gt;12 blocks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;" vertex="1" parent="1"><mxGeometry x="240" y="340" width="230" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;333 text embeddings t&lt;/b&gt;&lt;br&gt;512 numbers each, length 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="520" y="340" width="170" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Training only:&lt;/b&gt; cross-entropy on 100 x scores (pair + crop + disease)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;" vertex="1" parent="1"><mxGeometry x="750" y="80" width="190" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Cosine similarity&lt;/b&gt;&lt;br&gt;v . t for every pair = 333 scores" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="750" y="210" width="190" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Calibration&lt;/b&gt;&lt;