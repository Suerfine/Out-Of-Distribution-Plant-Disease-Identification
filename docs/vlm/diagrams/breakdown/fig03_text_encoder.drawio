="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5335;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;12 Transformer blocks&lt;/b&gt;&lt;br&gt;causal self-attention: each token only looks at the tokens to its left" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;" vertex="1" parent="1"><mxGeometry x="228" y="304" width="520" height="50" as="geometry"/></mxCell><mxCell id="c28" value="Keep the output at &lt;b&gt;[end]&lt;/b&gt;: the only position that has read the whole sentence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="228" y="386" width="520" height="40" as="geometry"/></mxCell><mxCell id="c29" value="Layer norm + linear projection to 512 numbers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;" vertex="1" parent="1"><mxGeometry x="228" y="458" width="520" height="36" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Text embedding t&lt;/b&gt;, scaled to length 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="228" y="526" width="520" height="36" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackg