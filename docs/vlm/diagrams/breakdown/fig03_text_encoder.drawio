ometry"/></mxCell><mxCell id="c37" value="Trained in this project" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="243" y="590" width="191" height="26" as="geometry"/></mxCell><mxCell id="c38" value="Data in" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;fontSize=11;" vertex="1" parent="1"><mxGeometry x="446" y="590" width="79" height="26" as="geometry"/></mxCell><mxCell id="c39" value="Loss (training only)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="537" y="590" width="170" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>