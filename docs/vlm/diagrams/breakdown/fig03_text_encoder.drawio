<mxfile><diagram name="fig03_text_encoder"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Inside the text encoder: where the learned crop and disease vectors enter&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="[start]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="60" height="34" as="geometry"/></mxCell><mxCell id="c3" value="a" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;fontSize=11;" vertex="1" parent="1"><mxGeometry x="104" y="56" width="60" height="34" as="geometry"/></mxCell><mxCell id="c4" value="photo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;fontSize=11;" vertex="1" parent="1"><mxGeometry x="168" y="56" width="60" height="34" as="geometry"/></mxCell><mxCell id="c5" value="of" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;fontSize=11;" vertex="1" parent="1"><mxGeometry x="232" y="56" width="60" height="34" as="geometry"/></mxCell><mxCell id="c6" value="[CROP]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="296" y="56" width="60" height="34" as="geometry"/></mxCell><mxCell id="c7" value="leaves" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFami