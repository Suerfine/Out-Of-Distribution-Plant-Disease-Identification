<mxfile><diagram name="fig05_loss"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Training objective: three classification heads share one image embedding&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Image embedding v&lt;/b&gt; (from the image encoder, length 1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="640" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Total loss&lt;/b&gt; = 1.0 x pair + 0.5 x crop + 0.5 x disease &amp;nbsp;(+ 25 x text anchor from v10.1 on)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="640" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Pair head&lt;/b&gt;&lt;br&gt;100 x cos(v, t) against the&lt;br&gt;seen pair prompts (323)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="200" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Softmax + cross-entropy&lt;br&gt;with the true pair&lt;br&gt;&lt;b&gt;weight 1.0&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="70" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html