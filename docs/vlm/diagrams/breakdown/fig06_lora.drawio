 x 768&lt;br&gt;random start" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="274" width="120" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;B&lt;/b&gt;: 768 x 16&lt;br&gt;starts at zero" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="274" width="120" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;+&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;ellipse;rounded=0;fontSize=16;" vertex="1" parent="1"><mxGeometry x="800" y="192" width="40" height="40" as="geometry"/></mxCell><mxCell id="c15" value="output" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="860" y="190" width="66" height="44" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ADB5BD;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="output = W x + 2 x B (A x), where 2 = alpha / rank.&amp;nbsp; B starts at zero, so training begins exactly at pretrained CLIP. Rank 16 means the update can only change the weight along 16 directions." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="480" y="168" width="290" height="76" as="geometry"/></mxCell><mxCell id="c24" value="Trained: 1.57M numbers (8 blocks, rank 16) against 86M frozen in the encoder, about 1.8%." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="900" height="22" as="geometry"/></mxCell><mxCell id="c25" value="Pretrained CLIP, frozen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="191" height="26" as="geometry"/></mxCell><mxCell id="c26" value="Trained in this project" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="243" y="418" width="191" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>