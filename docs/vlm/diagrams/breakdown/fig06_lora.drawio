<mxfile><diagram name="fig06_lora"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;LoRA: the pretrained weight stays frozen, a small trained side path is added to it&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Image cut into 196 patches&lt;br&gt;+ 1 class token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Blocks 1-4&lt;/b&gt;&lt;br&gt;frozen, no adapter" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="220" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Blocks 5-12&lt;/b&gt;&lt;br&gt;frozen weights + LoRA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="220" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Class token, projection to 512&lt;br&gt;= image embedding v" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="220" height="50" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exi