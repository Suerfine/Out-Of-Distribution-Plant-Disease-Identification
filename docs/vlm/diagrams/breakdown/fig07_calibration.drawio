<mxfile><diagram name="fig07_calibration"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Calibration: subtracting gamma from seen-pair scores lets an unseen pair win&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Before calibration (gamma = 0)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#ADB5BD;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="440" height="200" as="geometry"/></mxCell><mxCell id="c3" value="Best seen pair&lt;br&gt;tomato late blight" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="50" y="84" width="110" height="40" as="geometry"/></mxCell><mxCell id="c4" value="0.31" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="88" width="310" height="32" as="geometry"/></mxCell><mxCell id="c5" value="Best unseen pair&lt;br&gt;tomato early blight" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="50" y="138" width="110" height="40" as="geometry"/></mxCell><mxCell id="c6" value="0.27" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="142" width="270" height="32" as="geometry"/></mxCell><mxCell id="c7" value="Prediction: tomato late blight (wrong)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="198" width="420" height="34" as="geometry"/></mxCell><mxCell id="c8" value="After calibration (gamma = 0.07)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#ADB5BD;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="500" y="50" width="440" height="200" as="geometry"/></mxCell><mxCell id="c9" value="Best seen pair&lt;br&gt;tomato late blight" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="510" y="84" width="110" height="40" as="geometry"/></mxCell><mxCell id="c10" value="0.31 - 0.07 = 0.24" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="88" width="240" height="32" as="geometry"/></mxCell><mxCell id="c11" value="Best unseen pair&lt;br&gt;tomato early blight" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="510" y="138" width="110" height="40" as="geometry"/></mxCell><mxCell id="c12" value="0.27" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="142" width="270" height="32" as="geometry"/></mxCell><mxCell id="c13" value="Prediction: tomato early blight (correct)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="198" width="420" height="34" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Example image: a tomato early blight leaf (an unseen pair).&lt;/b&gt; Bars are cosine scores. The model has only ever been rewarded for seen pairs, so their scores run high." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="900" height="36" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;v5.5 on the test sets&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="330" height="30" as="geometry"/></mxCell><mxCell id="c16" value="gamma = 0 (no calibration)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="330" height="30" as="geometry"/></mxCell><mxCell id="c17" value="gamma = 0.075 (chosen on validation)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="330" height="30" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Seen Top-1&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="312" width="170" height="30" as="geometry"/></mxCell><mxCell id="c19" value="67.6%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="342" width="170" height="30" as="geometry"/></mxCell><mxCell id="c20" value="52.2%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="372" width="170" height="30" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Unseen Top-1&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="312" width="170" height="30" as="geometry"/></mxCell><mxCell id="c22" value="28.7%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="342" width="170" height="30" as="geometry"/></mxCell><mxCell id="c23" value="84.3%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="372" width="170" height="30" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Harmonic mean&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="312" width="200" height="30" as="geometry"/></mxCell><mxCell id="c25" value="40.3%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="342" width="200" height="30" as="geometry"/></mxCell><mxCell id="c26" value="64.5%" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="372" width="200" height="30" as="geometry"/></mxCell><mxCell id="c27" value="A larger gamma rescues unseen images but also moves some seen images to unseen pairs. Gamma is the single value that gives the best harmonic mean on validation." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="900" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>