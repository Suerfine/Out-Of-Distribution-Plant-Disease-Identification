<mxfile><diagram name="fig08_validation"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Model selection without touching the test sets: pseudo-unseen validation, then refit&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Training set&lt;/b&gt;: 8,000 images, 323 seen pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="240" y="56" width="500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Fit set&lt;/b&gt;&lt;br&gt;the remaining images of 303 pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="270" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Val-seen&lt;/b&gt;&lt;br&gt;15% of the images of those 303 pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="355" y="140" width="270" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Pseudo-unseen&lt;/b&gt;&lt;br&gt;20 whole pairs held out (max 40 images each)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="670" y="140" width="270" height="56" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Stage 1&lt;/b&gt;: train on the fit set. After every epoch score val-seen + pseudo-unseen against the pair prompts and try every gamma." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="900" height="44" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Chosen: epoch and gamma&lt;/b&gt; with the best validation harmonic mean (averaged over 3 different splits from v5.8 on)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="900" height="40" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Stage 2&lt;/b&gt;: train a fresh model on all 8,000 images for the chosen number of epochs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="900" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Test once&lt;/b&gt;: 2,000 seen-pair images + 1,448 unseen-pair images, ranked against all 333 pairs with the chosen gamma" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="900" height="40" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="A pseudo-unseen pair is a real seen pair whose images are all removed from training, while its crop and its disease still appear in other training pairs. It imitates a true unseen pair." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="900" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>