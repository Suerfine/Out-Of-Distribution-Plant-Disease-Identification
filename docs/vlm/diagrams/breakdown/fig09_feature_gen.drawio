<mxfile><diagram name="fig09_feature_gen"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Feature generation (v11): invent image embeddings for the unseen pairs from their text&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Step 1. Learn text-to-image-embedding on the seen pairs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#ADB5BD;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="910" height="170" as="geometry"/></mxCell><mxCell id="c3" value="Seen pair&#x27;s text embedding + random noise" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="200" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Generator&lt;/b&gt;&lt;br&gt;2-layer network" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="160" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Fake image embedding" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="510" y="84" width="170" height="44" as="geometry"/></mxCell><mxCell id="c6" value="Real image embedding of that pair" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="170" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Critic&lt;/b&gt;: real or fake?&lt;br&gt;+ still classified as its pair?" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;" vertex="1" parent="1"><mxGeometry x="740" y="104" width="180" height="68" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="Step 2. Generate for the unseen pairs, then train a classifier over all 333 pairs" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#ADB5BD;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="910" height="150" as="geometry"/></mxCell><mxCell id="c13" value="Unseen pair&#x27;s text embedding + noise" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="200" height="56" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Generator&lt;/b&gt;&lt;br&gt;(from step 1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="290" width="160" height="56" as="geometry"/></mxCell><mxCell id="c15" value="300 synthetic image embeddings per unseen pair" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="510" y="290" width="170" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Cosine classifier&lt;/b&gt;&lt;br&gt;real seen + synthetic unseen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="290" width="180" height="56" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="No unseen image is used. The classifier now has training examples for every pair, so it is less biased toward seen pairs." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="900" height="24" as="geometry"/></mxCell><mxCell id="c21" value="Trained in this project" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="434" width="191" height="26" as="geometry"/></mxCell><mxCell id="c22" value="Data in" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;fontSize=11;" vertex="1" parent="1"><mxGeometry x="243" y="434" width="79" height="26" as="geometry"/></mxCell><mxCell id="c23" value="Scores / decisions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="334" y="434" width="156" height="26" as="geometry"/></mxCell><mxCell id="c24" value="Loss (training only)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="502" y="434" width="170" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>