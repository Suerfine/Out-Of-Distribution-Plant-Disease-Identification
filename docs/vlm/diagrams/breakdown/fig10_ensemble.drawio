<mxfile><diagram name="fig10_ensemble"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Ensemble (v6.3): two different models are put on one scale, then averaged&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;CLIP + LoRA (v10.3)&lt;/b&gt;&lt;br&gt;333 cosine scores" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="200" height="56" as="geometry"/></mxCell><mxCell id="c3" value="x 100, then log-softmax over the 333 pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="220" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;ConvNeXt crop network&lt;/b&gt;&lt;br&gt;log P(crop)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="44" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ConvNeXt disease network&lt;/b&gt;&lt;br&gt;log P(disease)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="200" height="44" as="geometry"/></mxCell><mxCell id="c6" value="Pair score = log P(crop) + log P(disease), then log-softmax over the 333 pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="290" y="196" width="220" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Weighted average&lt;/b&gt;&lt;br&gt;0.3 x CLIP + 0.7 x CNN" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="570" y="140" width="170" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Calibration&lt;/b&gt;&lt;br&gt;minus gamma (6.7) on seen pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="770" y="140" width="170" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Prediction&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="170" height="40" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Both members end as log-probabilities over the same 333 pairs, so adding them is meaningful. The weight 0.3 and gamma are chosen on validation. The two models make different mistakes, so the average is right more often than either." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="900" height="40" as="geometry"/></mxCell><mxCell id="c18" value="Trained in this project" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="191" height="26" as="geometry"/></mxCell><mxCell id="c19" value="Scores / decisions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="243" y="366" width="156" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>