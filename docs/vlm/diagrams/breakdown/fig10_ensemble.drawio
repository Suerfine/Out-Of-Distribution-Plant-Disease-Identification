<mxfile><diagram name="fig10_ensemble"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Ensemble (v6.7): three different models are put on one scale, then averaged&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;CLIP + LoRA, CoOp + CSP (v5.13)&lt;/b&gt;&lt;br&gt;333 cosine scores" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="56" as="geometry"/></mxCell><mxCell id="c3" value="x 100, then log-softmax over the 333 pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="220" height="56" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;ConvNeXt 224 px: crop&lt;/b&gt;&lt;br&gt;log P(crop)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="200" height="42" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;ConvNeXt 224 px: disease&lt;/b&gt;&lt;br&gt;log P(disease)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="200" height="42" as="geometry"/></mxCell><mxCell id="c6" value="log P(crop) + log P(disease), then log-softmax over the 333 pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="220" height="82" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ConvNeXt 336 px: crop&lt;/b&gt;&lt;br&gt;log P(crop)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="200" height="42" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ConvNeXt 336 px: disease&lt;/b&gt;&lt;br&gt;log P(disease)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="200" height="42" as="geometry"/></mxCell><mxCell id="c9" value="log P(crop) + log P(disease), then log-softmax over the 333 pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="290" y="266" width="220" height="82" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Weighted sum&lt;/b&gt;&lt;br&gt;0.2 x CLIP&lt;br&gt;+ 0.3 x CNN 224&lt;br&gt;+ 0.5 x CNN 336" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="570" y="148" width="170" height="86" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Calibration&lt;/b&gt;&lt;br&gt;minus gamma (6.4) on seen pairs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="770" y="161" width="170" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Prediction&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFami