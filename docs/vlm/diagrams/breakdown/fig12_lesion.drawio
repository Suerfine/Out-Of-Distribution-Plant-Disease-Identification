<mxfile><diagram name="fig12_lesion"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Two attempts to make the image encoder look at small lesions (neither was kept)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=15;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="c2" value="v7. Patch-level disease score" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#ADB5BD;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="910" height="150" as="geometry"/></mxCell><mxCell id="c3" value="196 patch outputs of the last block (one per 16 x 16 pixel square)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="50" y="96" width="210" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Project each patch to 512 numbers, cosine with every disease text embedding" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;" vertex="1" parent="1"><mxGeometry x="300" y="96" width="210" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Patch score&lt;/b&gt; of a disease = mean of its 8 best patches" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="550" y="96" width="170" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Pair score = class-token cosine + 1.0 x patch score of its disease" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;" vertex="1" parent="1"><mxGeometry x="760" y="96" width="160" height="70" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="v13. Local-to-global consistency (no labels needed)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#ADB5BD;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="30" y="220" width="910" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Global view&lt;/b&gt;&lt;br&gt;50-100% of the photo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="50" y="262" width="180" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Local view&lt;/b&gt;&lt;br&gt;10-35% of the photo, enlarged" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;" vertex="1" parent="1"><mxGeometry x="50" y="338" width="180" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Image encoder + LoRA&lt;/b&gt;&lt;br&gt;(the same network for both views)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="220" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Global embedding (treated as a fixed target)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="570" y="262" width="180" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Local embedding" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFFFFF;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="570" y="338" width="180" height="50" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Loss&lt;/b&gt; = 1 - cosine(local, global)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;" vertex="1" parent="1"><mxGeometry x="800" y="296" width="120" height="58" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#495057;fontFamily=Helvetica;fontSize=11;fontColor=#495057;labelBackgroundColor=#FFFFFF;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="Idea behind both: a lesion covers few pixels, so the single class-token embedding is dominated by leaf shape (the crop). v7 reads the small squares directly; v13 forces a small region to predict the whole image." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fontSize=11;align=left;fontColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="900" height="36" as="geometry"/></mxCell><mxCell id="c24" value="Pretrained CLIP, frozen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#F1F3F5;strokeColor=#868E96;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="468" width="191" height="26" as="geometry"/></mxCell><mxCell id="c25" value="Trained in this project" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#E7F0FF;strokeColor=#2F6FD0;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="243" y="468" width="191" height="26" as="geometry"/></mxCell><mxCell id="c26" value="Data in" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#EAF6EC;strokeColor=#4C9A66;fontSize=11;" vertex="1" parent="1"><mxGeometry x="446" y="468" width="79" height="26" as="geometry"/></mxCell><mxCell id="c27" value="Scores / decisions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FFF4D6;strokeColor=#C99A2E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="537" y="468" width="156" height="26" as="geometry"/></mxCell><mxCell id="c28" value="Loss (training only)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1F24;fillColor=#FDECEC;strokeColor=#C9504A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="705" y="468" width="170" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>