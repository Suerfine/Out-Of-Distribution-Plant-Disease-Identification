iddle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1344.7" y="525.8" width="91.5" height="20.0" as="geometry"/></mxCell><mxCell id="c129" value="stacking (γ)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1344.7" y="540.8" width="91.5" height="20.0" as="geometry"/></mxCell><mxCell id="c130" value="offset 3.0" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1354.6" y="557.6" width="71.8" height="19.0" as="geometry"/></mxCell><mxCell id="c131" value="seen 66.8" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1357.8" y="577.6" width="65.4" height="19.0" as="geometry"/></mxCell><mxCell id="c132" value="unseen 82.8" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1351.4" y="592.6" width="78.2" height="19.0" as="geometry"/></mxCell><mxCell id="c133" value="calibrated" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1354.6" y="612.6" width="71.8" height="19.0" as="geometry"/></mxCell><mxCell id="c134" value="(this bar)" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1357.5" y="627.5" width="66.0" height="18.0" as="geometry"/></mxCell><mxCell id="c135" style="html=1;endArrow=none;rounded=0;strokeColor=#000000;strokeWidth=1.0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834.5" y="263.4" as="sourcePoint"/><mxPoint x="973.5" y="263.4" as="targetPoint"/><Array as="points"><mxPoint x="834.5" y="253.4"/><mxPoint x="973.5" y="253.4"/></Array></mxGeometry></mxCell><mxCell id="c136" value="matched gain +2.7" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="845.8" y="234.1" width="116.5" height="19.0" as="geometry"/></mxCell><mxCell id="c137" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;html=1;fillColor=#E7E6E6;strokeColor=#000000;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="30.0" y="657.0" width="28.0" height="14.0" as="geometry"/></mxCell><mxCell id="c138" value="zero-shot CLIP" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="66.0" y="653.8" width="105.4" height="20.0" as="geometry"/></mxCell><mxCell id="c139" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;html=1;fillColor=#BDD7EE;strokeColor=#000000;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="198.0" y="657.0" width="28.0" height="14.0" as="geometry"/></mxCell><mxCell id="c140" value="trained CLIP" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="234.0" y="653.8" width="91.5" height="20.0" as="geometry"/></mxCell><mxCell id="c141" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;html=1;fillColor=#F8CBAD;strokeColor=#000000;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="352.0" y="657.0" width="28.0" height="14.0" as="geometry"/></mxCell><mxCell id="c142" value="CLIP + GAN + ConvNeXt pipeline" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="388.0" y="653.8" width="216.8" height="20.0" as="geometry"/></mxCell><mxCell id="c143" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;html=1;fillColor=#C5E0B4;strokeColor=#000000;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="632.0" y="657.0" width="28.0" height="14.0" as="geometry"/></mxCell><mxCell id="c144" value="calibrated stacking (γ)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="668.0" y="653.8" width="168.1" height="20.0" as="geometry"/></mxCell><mxCell id="c145" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.0;fillColor=#000000;fillStyle=hatch;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="863.0" y="657.0" width="28.0" height="14.0" as="geometry"/></mxCell><mxCell id="c146" value="matched baseline (re-run)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="899.0" y="653.8" width="182.0" height="20.0" as="geometry"/></mxCell><mxCell id="c147" value="+x / −x: change from the previous step" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1108.0" y="653.8" width="272.5" height="20.0" as="geometry"/></mxCell><mxCell id="c148" value="Last bar: the final pipeline with calibrated stacking (routing offset γ = 3.0, chosen on validation), which subtracts γ from every seen score: seen 72.9 → 66.8, unseen 48.3 → 82.8." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="689.8" width="1260.8" height="20.0" as="geometry"/></mxCell><mxCell id="c149" value="Hatched bar: Hein&#x27;s re-run of the same un-anchored GAN (v11.3 settings) in his pipeline, the matched baseline for crop anchoring. v11.3 → re-run (44.0 → 46.3) is run-to-run difference, not a method change." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="709.8" width="1434.8" height="20.0" as="geometry"/></mxCell><mxCell id="c150" value="“+ disease-only head” also brings in the ConvNeXt crop scores (measured alone: 49.0 → 50.9) and two-expert routing; the final step hands seen predictions to the ConvNeXt (+104 net correct seen images)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="729.8" width="1407.0" height="20.0" as="geometry"/></mxCell><mxCell id="c151" value="Read with care: at γ = 0, HM mostly tracks how seen-biased a model is (r = 1.00 with the share of unseen images routed to unseen pairs, 25 LoRA runs), not how well it recognises." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="749.8" width="1246.9" height="20.0" as="geometry"/></mxCell><mxCell id="c152" value="Example: training CSP longer (v4, 3 epochs → v4.2, 13 epochs) lowers HM at γ = 0 from 34.9 to 26.0 with AUSUC unchanged (38.4); LoRA then adds +17.5 AUSUC. Calibrated HM is the protocol&#x27;s headline number." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#1B1F24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="769.8" width="1427.8" height="20.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>