<mxfile host="app.diagrams.net"><diagram id="p0" name="v11.3 walk-up at γ = 0"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="v11.3's lineage at γ = 0: only the steps that raised uncalibrated HM" style="whiteSpace=wrap;html=1;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=20;fontStyle=1;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Each box sits at its test HM with no calibration (γ = 0). Green boxes and arrows = the walk-up: a step that beats the best HM so far by more than 2 points. Grey boxes = steps v11.3 still inherits but that did not raise HM at γ = 0. Test numbers are used because v1–v4.1 have no validation; validation HM at γ = 0 is shown where it exists." style="whiteSpace=wrap;html=1;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=12;align=left;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2100" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="785.0" width="1940" height="1" as="geometry"/></mxCell><mxCell id="c5" value="0%" style="whiteSpace=wrap;html=1;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=12;align=left;fontColor=#555555;align=right;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="775.0" width="45" height="20" as="geometry"/></mxCell><mxCell id="c6" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#e6e6e6;strokeColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="655.0" width="1940" height="1" as="geometry"/></mxCell><mxCell id="c7" value="