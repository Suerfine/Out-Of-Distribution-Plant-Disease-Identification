<mxfile host="app.diagrams.net" pages="3">
  <diagram id="p0" name="1 Pipeline (inference)">
    <mxGraphModel dx="1034" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=20;fontStyle=1;align=left;fontSize=20;" value="v15 gated router: how one leaf photo is classified" vertex="1">
          <mxGeometry height="34" width="1600" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;text;fillColor=none;strokeColor=none;fontSize=12;align=left;fontColor=#555555;fontSize=12;" value="In one line: two models score the photo, a gate decides &#39;known combination or new one?&#39;, and a specialist for that group names the pair. (train/route.py · same members and split as the v6.3 ensemble · after COSMO, Atzmon &amp; Chechik 2019)" vertex="1">
          <mxGeometry height="24" width="1700" x="40" y="56" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="&lt;b&gt;Leaf photo&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="150" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;① Model A: v10.3&lt;/b&gt;&lt;br&gt;CLIP + LoRA + learned prompts&lt;br&gt;scores all 333 pairs" vertex="1">
          <mxGeometry height="100" width="250" x="240" y="220" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="&lt;b&gt;① Model B: ConvNeXt-Base&lt;/b&gt;&lt;br&gt;CNN: P(crop) × P(disease)&lt;br&gt;scores all 333 pairs" vertex="1">
          <mxGeometry height="100" width="250" x="240" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c7" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontSize=11;" target="c5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" edge="1" parent="1" source="c4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;fontSize=11;" target="c6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="&lt;b&gt;Two score sheets&lt;/b&gt;&lt;br&gt;each turned into&lt;br&gt;log-probabilities&lt;br&gt;over the 333 pairs" vertex="1">
          <mxGeometry height="120" width="200" x="560" y="315" as="geometry" />
        </mxCell>
        <mxCell id="c10" edge="1" parent="1" source="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;fontSize=11;" target="c9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" edge="1" parent="1" source="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;fontSize=11;" target="c9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;② Margins: how close does a NEW pair come?&lt;/b&gt;&lt;br&gt;&lt;br&gt;margin = best NEW pair − best KNOWN pair&lt;br&gt;(10 new pairs vs 323 known pairs)&lt;br&gt;&lt;br&gt;computed for A, for B and for their mix&lt;br&gt;M = 0.3·A + 0.7·B (the v6.3 ensemble)" vertex="1">
          <mxGeometry height="170" width="330" x="830" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;③ Gate: is this a new combination?&lt;/b&gt;&lt;br&gt;&lt;br&gt;weighs the 3 margins&lt;br&gt;(the mix counts about 3× more)&lt;br&gt;and adds a cut-off tuned on validation&lt;br&gt;&lt;br&gt;→ &lt;b&gt;P(unseen)&lt;/b&gt; for this photo" vertex="1">
          <mxGeometry height="170" width="300" x="1220" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c14" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;fontSize=11;" target="c12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" edge="1" parent="1" source="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" target="c13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b&gt;④ Known-pair specialist&lt;/b&gt;&lt;br&gt;0.3·A + 0.7·B, picks among the&lt;br&gt;&lt;b&gt;323 seen pairs only&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="330" x="830" y="330" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="&lt;b&gt;④ New-pair specialist&lt;/b&gt;&lt;br&gt;0.3·A + 0.7·B, picks among the&lt;br&gt;&lt;b&gt;10 unseen pairs only&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="330" x="830" y="480" as="geometry" />
        </mxCell>
        <mxCell id="c18" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" target="c16" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" edge="1" parent="1" source="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;fontSize=11;" target="c17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;" value="&lt;b&gt;⑤ Switch&lt;/b&gt;&lt;br&gt;&lt;br&gt;P(unseen) &gt; 50%&lt;br&gt;→ answer from the &lt;b&gt;new-pair&lt;/b&gt; specialist&lt;br&gt;&lt;br&gt;P(unseen) ≤ 50%&lt;br&gt;→ answer from the &lt;b&gt;known-pair&lt;/b&gt; specialist&lt;br&gt;&lt;br&gt;&lt;i&gt;The other specialist is ignored completely.&lt;/i&gt;" vertex="1">
          <mxGeometry height="240" width="300" x="1220" y="330" as="geometry" />
        </mxCell>
        <mxCell id="c21" edge="1" parent="1" source="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;" target="c20" value="P(unseen)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c22" edge="1" parent="1" source="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.1875;fontSize=11;" target="c20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" edge="1" parent="1" source="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.8125;fontSize=11;" target="c20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c24" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=13;" value="&lt;b&gt;Predicted pair&lt;/b&gt;" vertex="1">
          <mxGeometry height="80" width="160" x="1580" y="410" as="geometry" />
        </mxCell>
        <mxCell id="c25" edge="1" parent="1" source="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" target="c24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=8;spacingRight=8;fontSize=12;" value="&lt;b&gt;What the gate is really checking&lt;/b&gt;&lt;br&gt;&lt;br&gt;Both models were trained only on the 323 known pairs, so they almost always rate some known pair highest: the margin is nearly always negative. What matters is &lt;b&gt;how far behind&lt;/b&gt; the best new pair is. Far behind (about −10) → nothing new fits, keep it with the known pairs. Close behind (about −2 to −4) → a new pair is a serious candidate, send it to the new-pair specialist." vertex="1">
          <mxGeometry height="150" width="860" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c27" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Test photo (true pair)&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="250" x="40" y="790" as="geometry" />
        </mxCell>
        <mxCell id="c28" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Mix margin&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="110" x="290" y="790" as="geometry" />
        </mxCell>
        <mxCell id="c29" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;P(unseen)&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="100" x="400" y="790" as="geometry" />
        </mxCell>
        <mxCell id="c30" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Sent to&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="120" x="500" y="790" as="geometry" />
        </mxCell>
        <mxCell id="c31" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Answer&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="280" x="620" y="790" as="geometry" />
        </mxCell>
