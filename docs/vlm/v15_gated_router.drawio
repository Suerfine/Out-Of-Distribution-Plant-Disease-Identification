          <mxGeometry height="32" width="280" x="620" y="886" as="geometry" />
        </mxCell>
        <mxCell id="c47" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" value="unseen · tomato early blight" vertex="1">
