        <mxCell id="e4" edge="1" parent="1" source="batch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" target="scores" value="v (same for all three)">
          <mxGeometry relative="1" as="geometry" />
