        <mxCell id="e7" edge="1" parent="1" source="disv" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" target="subst">
