        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="subst" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="txtenc" value="323 + 55 + 175 sentences">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="txtenc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.16;exitY=1;" target="tpair">
