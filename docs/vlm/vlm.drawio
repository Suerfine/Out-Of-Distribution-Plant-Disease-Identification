        <mxCell id="e10" edge="1" parent="1" source="txtenc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="tcrop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="txtenc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.84;exitY=1;" target="tdis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="tpair" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;entryX=0.16;entryY=0;" target="scores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="tcrop" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="scores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="tdis" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;entryX=0.84;entryY=0;" target="scores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="scores" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.16;exitY=1;" target="lpair">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="scores" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="lcrop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="scores" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.84;exitY=1;" target="ldis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="lpair" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;entryX=0.16;entryY=0;" target="total" value="× 1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="lcrop" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" target="total" value="× 0.5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" edge="1" parent="1" source="ldis" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;entryX=0.84;entryY=0;" target="total" value="× 0.5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="grad" edge="1" parent="1" source="total" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#CC0000;dashed=1;strokeWidth=2;fontSize=10;fontColor=#CC0000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="learn" value="&lt;b&gt;backward&lt;/b&gt;: gradients flow back&lt;br&gt;through the frozen text encoder&lt;br&gt;into the 230 vectors only;&lt;br&gt;AdamW (cosine LR) updates them">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-20" y="80" as="offset" />
            <Array as="points">
              <mxPoint x="895" y="895" />
              <mxPoint x="895" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="keyidea" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;arcSize=4;" value="&lt;b&gt;Key idea&lt;/b&gt;&lt;br&gt;CLIP&#39;s 150M weights never change. Only the &lt;i&gt;input words&lt;/i&gt; of the prompt move: each crop/disease vector is nudged from CLIP&#39;s generic word towards whatever separates that class from the others in DPD field photos. Images stay put; the sentence points move to land on their images." vertex="1">
          <mxGeometry height="120" width="390" x="950" y="100" as="geometry" />
        </mxCell>
        <mxCell id="unseen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;arcSize=4;" value="&lt;b&gt;Why unseen pairs work (test time)&lt;/b&gt;&lt;br&gt;Build all 333 pair sentences, including the 10 unseen ones, e.g.&lt;br&gt;&quot;a photo of [apple] leaves with [aphis_spp]: ...&quot;&lt;br&gt;Both vectors were trained in OTHER pairs; they are just combined. No new parameters. Seen-pair scores are lowered by gamma so unseen pairs can win." vertex="1">
          <mxGeometry height="130" width="390" x="950" y="240" as="geometry" />
        </mxCell>
        <mxCell id="limit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;arcSize=4;" value="&lt;b&gt;Limit&lt;/b&gt;&lt;br&gt;Because the image vectors are fixed, two diseases that look the same to CLIP&#39;s image encoder cannot be separated by any choice of text vectors." vertex="1">
          <mxGeometry height="80" width="390" x="950" y="390" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;arcSize=4;" value="Legend" vertex="1">
          <mxGeometry height="190" width="390" x="950" y="490" as="geometry" />
        </mxCell>
        <mxCell id="lg1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" value="frozen CLIP part" vertex="1">
          <mxGeometry height="30" width="170" x="965" y="520" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" value="learnable parameters" vertex="1">
          <mxGeometry height="30" width="170" x="1155" y="520" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="image data" vertex="1">
          <mxGeometry height="30" width="170" x="965" y="565" as="geometry" />
        </mxCell>
        <mxCell id="lg4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="text / prompts" vertex="1">
          <mxGeometry height="30" width="170" x="1155" y="565" as="geometry" />
        </mxCell>
        <mxCell id="lg5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="scores" vertex="1">
          <mxGeometry height="30" width="170" x="965" y="610" as="geometry" />
        </mxCell>
        <mxCell id="lg6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" value="losses" vertex="1">
          <mxGeometry height="30" width="170" x="1155" y="610" as="geometry" />
        </mxCell>
        <mxCell id="lg7" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#CC0000;" value="red dashed arrow = gradient (backward pass)" vertex="1">
          <mxGeometry height="24" width="360" x="965" y="648" as="geometry" />
        </mxCell>
        <mxCell id="stages" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#666666;arcSize=4;" value="AROUND THE LOOP: choosing epochs and gamma without touching the test sets" vertex="1">
          <mxGeometry height="140" width="1320" x="20" y="960" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Stage 1: make validation splits&lt;/b&gt;&lt;br&gt;hold out whole seen pairs as pseudo-unseen + some images as val-seen (several random splits)" vertex="1">
          <mxGeometry height="80" width="230" x="40" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Train with the loop above&lt;/b&gt;&lt;br&gt;after every epoch, score the val images and try every gamma" vertex="1">
          <mxGeometry height="80" width="230" x="300" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Pick (epoch, gamma)&lt;/b&gt;&lt;br&gt;with the best harmonic mean, averaged over the splits" vertex="1">
          <mxGeometry height="80" width="230" x="560" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Stage 2: refit&lt;/b&gt;&lt;br&gt;reset the vectors, retrain on ALL 8,000 train images for the chosen epochs" vertex="1">
          <mxGeometry height="80" width="230" x="820" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Test once&lt;/b&gt;&lt;br&gt;test seen + test unseen, ranked over all 333 pairs, chosen gamma applied" vertex="1">
          <mxGeometry height="80" width="240" x="1080" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="es1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es4" edge="1" parent="1" source="s4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Xx38-Bh-AtQllX_fLkr_-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;score(seen pair)&amp;nbsp; &amp;nbsp;= score − γ&lt;/div&gt;&lt;div&gt;score(unseen pair) = score&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (unchanged)&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="310" x="1205" y="750" as="geometry" />
        </mxCell>
        <mxCell id="Xx38-Bh-AtQllX_fLkr_-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Cosine similarity between the image vector and the pair’s sentence vector" vertex="1">
          <mxGeometry height="30" width="260" x="1230" y="820" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
