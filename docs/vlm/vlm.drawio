<mxfile host="app.diagrams.net">
  <diagram name="Training (v4-v6, v8)" id="mWjACX2QDCIm8KMyKjaQ">
    <mxGraphModel dx="1414" dy="866" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Training: compositional prompt learning on a frozen CLIP&lt;/b&gt; (v4-v6, v8; train/train.py + dpd/prompt_learner.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1320" height="40" as="geometry" />
        </mxCell>

        <!-- Main loop container -->
        <mxCell id="loop" value="ONE TRAINING STEP (repeated for every batch, every epoch)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#666666;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="900" height="860" as="geometry" />
        </mxCell>

        <!-- Image path -->
        <mxCell id="img" value="&lt;b&gt;Training images&lt;/b&gt;&lt;br&gt;8,000 photos of 323 seen pairs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="imgenc" value="&lt;b&gt;CLIP image encoder&lt;/b&gt;&lt;br&gt;FROZEN (never changes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nograd" value="no gradients reach here" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#CC0000;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="282" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Cached image vectors&lt;/b&gt;&lt;br&gt;8,000 × 512&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;computed ONCE, saved in runs/cache/&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="batch" value="&lt;b&gt;Batch of image vectors v&lt;/b&gt;&lt;br&gt;B × 512 (shuffled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Text path -->
        <mxCell id="tmpl" value="&lt;b&gt;Prompt templates&lt;/b&gt; (fixed text, &lt;b&gt;x&lt;/b&gt; = placeholder)&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• pair (323): a photo of &lt;b&gt;x&lt;/b&gt; leaves with &lt;b&gt;x&lt;/b&gt;: &amp;lt;description&amp;gt;.&lt;br&gt;• crop (55): a photo of &lt;b&gt;x&lt;/b&gt; leaves.&lt;br&gt;• disease (175): a photo of leaves with &lt;b&gt;x&lt;/b&gt;: &amp;lt;description&amp;gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="190" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="subst" value="&lt;b&gt;Fill the placeholders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;each x's token embedding is replaced by the current crop / disease vector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="txtenc" value="&lt;b&gt;CLIP text encoder&lt;/b&gt;&lt;br&gt;FROZEN (weights fixed, but gradients pass THROUGH it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tpair" value="&lt;b&gt;t_pair&lt;/b&gt;&lt;br&gt;323 × 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="550" width="106" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tcrop" value="&lt;b&gt;t_crop&lt;/b&gt;&lt;br&gt;55 × 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="412" y="550" width="106" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tdis" value="&lt;b&gt;t_disease&lt;/b&gt;&lt;br&gt;175 × 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="524" y="550" width="106" height="50" as="geometry" />
        </mxCell>

        <!-- Learnable vectors -->
        <mxCell id="learn" value="LEARNABLE: the only trained parameters" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffaf3;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#994C00;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="670" y="280" width="200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cropv" value="&lt;b&gt;crop vectors&lt;/b&gt;&lt;br&gt;55 × 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="695" y="315" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="disv" value="&lt;b&gt;disease vectors&lt;/b&gt;&lt;br&gt;175 × 512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="695" y="375" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="initnote" value="230 vectors ≈ 118k numbers.&lt;br&gt;Start = CLIP's own embedding of the name (e.g. mean of &quot;early&quot;, &quot;blight&quot;)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#994C00;" vertex="1" parent="1">
          <mxGeometry x="680" y="430" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Scores and losses -->
        <mxCell id="scores" value="&lt;b&gt;Similarity scores = 100 × cos(v, t)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pair: B × 323 | crop: B × 55 | disease: B × 175&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="650" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lpair" value="&lt;b&gt;pair loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CE: true pair's sentence highest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="760" width="106" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lcrop" value="&lt;b&gt;crop loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CE: true crop highest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="412" y="760" width="106" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ldis" value="&lt;b&gt;disease loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CE: true disease highest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="524" y="760" width="106" height="60" as="geometry" />
        </mxCell>
        <mxCell id="total" value="&lt;b&gt;Total loss = pair + 0.5 × crop + 0.5 × disease&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="870" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="whyaux" value="crop/disease losses make each vector mean something ON ITS OWN, so it still works in pairs it never appeared in" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="640" y="760" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Forward edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="img" target="imgenc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="imgenc" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="sample" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="cache" target="batch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="v (same for all three)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="batch" target="scores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="tmpl" target="subst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;exitX=0;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="cropv" target="subst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="disv" target="subst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="323 + 55 + 175 sentences" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="subst" target="txtenc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.16;exitY=1;" edge="1" parent="1" source="txtenc" target="tpair">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="txtenc" target="tcrop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.84;exitY=1;" edge="1" parent="1" source="txtenc" target="tdis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;entryX=0.16;entryY=0;" edge="1" parent="1" source="tpair" target="scores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="tcrop" target="scores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;entryX=0.84;entryY=0;" edge="1" parent="1" source="tdis" target="scores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.16;exitY=1;" edge="1" parent="1" source="scores" target="lpair">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="scores" target="lcrop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.84;exitY=1;" edge="1" parent="1" source="scores" target="ldis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="× 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;entryX=0.16;entryY=0;" edge="1" parent="1" source="lpair" target="total">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="× 0.5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="lcrop" target="total">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="× 0.5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;entryX=0.84;entryY=0;" edge="1" parent="1" source="ldis" target="total">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backward pass -->
        <mxCell id="grad" value="&lt;b&gt;backward&lt;/b&gt;: gradients flow back&lt;br&gt;through the frozen text encoder&lt;br&gt;into the 230 vectors only;&lt;br&gt;AdamW (cosine LR) updates them" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#CC0000;dashed=1;strokeWidth=2;fontSize=10;fontColor=#CC0000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="total" target="learn">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="895" y="895" />
              <mxPoint x="895" y="390" />
            </Array>
            <mxPoint x="-20" y="80" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Right-hand explanation panels -->
        <mxCell id="keyidea" value="&lt;b&gt;Key idea&lt;/b&gt;&lt;br&gt;CLIP's 150M weights never change. Only the &lt;i&gt;input words&lt;/i&gt; of the prompt move: each crop/disease vector is nudged from CLIP's generic word towards whatever separates that class from the others in DPD field photos. Images stay put; the sentence points move to land on their images." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="950" y="100" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="unseen" value="&lt;b&gt;Why unseen pairs work (test time)&lt;/b&gt;&lt;br&gt;Build all 333 pair sentences, including the 10 unseen ones, e.g.&lt;br&gt;&quot;a photo of [apple] leaves with [aphis_spp]: ...&quot;&lt;br&gt;Both vectors were trained in OTHER pairs; they are just combined. No new parameters. Seen-pair scores are lowered by gamma so unseen pairs can win." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="950" y="240" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="limit" value="&lt;b&gt;Limit&lt;/b&gt;&lt;br&gt;Because the image vectors are fixed, two diseases that look the same to CLIP's image encoder cannot be separated by any choice of text vectors." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="950" y="390" width="390" height="80" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=11;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="950" y="490" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="frozen CLIP part" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="520" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="learnable parameters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1155" y="520" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="image data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="565" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="text / prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1155" y="565" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="scores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="610" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg6" value="losses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1155" y="610" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg7" value="red dashed arrow = gradient (backward pass)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="965" y="648" width="360" height="24" as="geometry" />
        </mxCell>

        <!-- Around the loop: stages -->
        <mxCell id="stages" value="AROUND THE LOOP: choosing epochs and gamma without touching the test sets" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#666666;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="960" width="1320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Stage 1: make validation splits&lt;/b&gt;&lt;br&gt;hold out whole seen pairs as pseudo-unseen + some images as val-seen (several random splits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Train with the loop above&lt;/b&gt;&lt;br&gt;after every epoch, score the val images and try every gamma" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="1000" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Pick (epoch, gamma)&lt;/b&gt;&lt;br&gt;with the best harmonic mean, averaged over the splits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="1000" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Stage 2: refit&lt;/b&gt;&lt;br&gt;reset the vectors, retrain on ALL 8,000 train images for the chosen epochs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="1000" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Test once&lt;/b&gt;&lt;br&gt;test seen + test unseen, ranked over all 333 pairs, chosen gamma applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1000" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="es1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
