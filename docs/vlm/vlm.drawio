      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;Training: compositional prompt learning on a frozen CLIP&lt;/b&gt; (v4-v4.2, v4.3; train/train.py + dpd/prompt_learner.py)" vertex="1">
          <mxGeometry height="40" width="1320" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#666666;arcSize=2;" value="ONE TRAINING STEP (repeated for every batch, every epoch)" vertex="1">
          <mxGeometry height="860" width="900" x="330" y="120" as="geometry" />
        </mxCell>
        <mxCell id="img" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Training images&lt;/b&gt;&lt;br&gt;8,000 photos of 323 seen pairs" vertex="1">
          <mxGeometry height="60" width="180" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="imgenc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;CLIP image encoder&lt;/b&gt;&lt;br&gt;FROZEN (never changes)" vertex="1">
          <mxGeometry height="60" width="180" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="nograd" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#CC0000;fontStyle=2;" value="no gradients reach here" vertex="1">
          <mxGeometry height="20" width="180" x="40" y="282" as="geometry" />
        </mxCell>
        <mxCell id="cache" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Cached image vectors&lt;/b&gt;&lt;br&gt;8,000 × 512&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;computed ONCE, saved in runs/cache/&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="180" x="40" y="320" as="geometry" />
        </mxCell>
        <mxCell id="batch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Batch of image vectors v&lt;/b&gt;&lt;br&gt;B × 512 (shuffled)" vertex="1">
          <mxGeometry height="60" width="180" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="tmpl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Prompt templates&lt;/b&gt; (fixed text, &lt;b&gt;x&lt;/b&gt; = placeholder)&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• pair (323): a photo of &lt;b&gt;x&lt;/b&gt; leaves with &lt;b&gt;x&lt;/b&gt;: &amp;lt;description&amp;gt;.&lt;br&gt;• crop (55): a photo of &lt;b&gt;x&lt;/b&gt; leaves.&lt;br&gt;• disease (175): a photo of leaves with &lt;b&gt;x&lt;/b&gt;: &amp;lt;description&amp;gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="330" x="300" y="190" as="geometry" />
        </mxCell>
        <mxCell id="subst" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Fill the placeholders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;each x&#39;s token embedding is replaced by the current crop / disease vector&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="330" x="300" y="330" as="geometry" />
        </mxCell>
        <mxCell id="txtenc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;CLIP text encoder&lt;/b&gt;&lt;br&gt;FROZEN (weights fixed, but gradients pass THROUGH it)" vertex="1">
          <mxGeometry height="60" width="330" x="300" y="440" as="geometry" />
        </mxCell>
        <mxCell id="tpair" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;t_pair&lt;/b&gt;&lt;br&gt;323 × 512" vertex="1">
          <mxGeometry height="50" width="106" x="300" y="550" as="geometry" />
        </mxCell>
        <mxCell id="tcrop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;t_crop&lt;/b&gt;&lt;br&gt;55 × 512" vertex="1">
          <mxGeometry height="50" width="106" x="412" y="550" as="geometry" />
        </mxCell>
        <mxCell id="tdis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;t_disease&lt;/b&gt;&lt;br&gt;175 × 512" vertex="1">
          <mxGeometry height="50" width="106" x="524" y="550" as="geometry" />
        </mxCell>
        <mxCell id="learn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffaf3;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontSize=11;fontColor=#994C00;arcSize=4;" value="LEARNABLE: the only trained parameters" vertex="1">
          <mxGeometry height="220" width="200" x="670" y="280" as="geometry" />
        </mxCell>
        <mxCell id="cropv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;crop vectors&lt;/b&gt;&lt;br&gt;55 × 512" vertex="1">
          <mxGeometry height="50" width="150" x="695" y="315" as="geometry" />
        </mxCell>
        <mxCell id="disv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;disease vectors&lt;/b&gt;&lt;br&gt;175 × 512" vertex="1">
          <mxGeometry height="50" width="150" x="695" y="375" as="geometry" />
        </mxCell>
        <mxCell id="initnote" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#994C00;" value="230 vectors ≈ 118k numbers.&lt;br&gt;Start = CLIP&#39;s own embedding of the name (e.g. mean of &quot;early&quot;, &quot;blight&quot;)" vertex="1">
          <mxGeometry height="60" width="180" x="680" y="430" as="geometry" />
        </mxCell>
        <mxCell id="scores" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Similarity scores = 100 × cos(v, t)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pair: B × 323 | crop: B × 55 | disease: B × 175&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="330" x="300" y="650" as="geometry" />
        </mxCell>
        <mxCell id="lpair" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;pair loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CE: true pair&#39;s sentence highest&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="106" x="300" y="760" as="geometry" />
        </mxCell>
        <mxCell id="lcrop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;crop loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CE: true crop highest&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="106" x="412" y="760" as="geometry" />
        </mxCell>
        <mxCell id="ldis" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;disease loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CE: true disease highest&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="106" x="524" y="760" as="geometry" />
        </mxCell>
        <mxCell id="total" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Total loss = pair + 0.5 × crop + 0.5 × disease&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="330" x="300" y="870" as="geometry" />
        </mxCell>
        <mxCell id="whyaux" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#666666;" value="crop/disease losses make each vector mean something ON ITS OWN, so it still works in pairs it never appeared in" vertex="1">
          <mxGeometry height="60" width="200" x="640" y="760" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="img" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="imgenc">
