<mxfile host="app.diagrams.net"><diagram id="ladder" name="Baseline ladder"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ladder-1" value="&lt;b&gt;VLM baseline ladder&lt;/b&gt;: a target becomes the new baseline if its validation HM beats the current baseline by &amp;gt; 2 points (highest HM wins when several pass). Test numbers never decide; γ-free test evidence is shown for context." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="ladder-2" value="&lt;b&gt;v3&lt;/b&gt; zero-shot CLIP&lt;br&gt;clean names + symptom descriptions&lt;br&gt;&lt;i&gt;no validation (no training)&lt;/i&gt;&lt;br&gt;test HM 10.2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="80" as="geometry"/></mxCell><mxCell id="ladder-3" value="&lt;b&gt;v4.2&lt;/b&gt; CSP prompt learning&lt;br&gt;val HM &lt;b&gt;46.57&lt;/b&gt; (3 splits)&lt;br&gt;test HM 51.8 · AUSUC 38.4" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="80" as="geometry"/></mxCell><mxCell id="ladder-4" value="+35.0 test AUSUC&lt;br&gt;(no val for v3)" style="endArrow=block;html=1;strokeWidth=3;fontSize=11;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ladder-2" target="ladder-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ladder-5" value="v4.3 BioCLIP&lt;br&gt;48.06 (+1.49) ✗" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" pare