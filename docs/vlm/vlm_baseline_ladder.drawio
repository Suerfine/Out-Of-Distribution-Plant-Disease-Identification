HM 66.3 · AUSUC 55.4&lt;br&gt;&lt;b&gt;best single VLM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeColor=#E07000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="250" height="80" as="geometry"/></mxCell><mxCell id="ladder-32" value="+2.84 val HM" style="endArrow=block;html=1;strokeWidth=3;fontSize=11;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ladder-22" target="ladder-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ladder-33" value="v5.14 + primitive branches&lt;br&gt;63.07 (+0.48) ✗&lt;br&gt;&lt;i&gt;AUSUC +2.3 sig+&lt;/i&gt;&lt;br&gt;&lt;b&gt;highest val HM of any single CLIP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;strokeColor=#E07000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="340" y="720" width="140" height="80" as="geometry"/></mxCell><mxCell id="ladder-34" value="v11.5 GAN on v5.13&lt;br&gt;59.43 (−3.16) ✗" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="492" y="720" width="140" height="80" as="geometry"/></mxCell><mxCell id="ladder-35" value="&lt;b&gt;v6.5&lt;/b&gt; v5.13 + ConvNeXt-B ensemble&lt;br&gt;val HM &lt;b&gt;67.12&lt;/b&gt; (split 42)&lt;br&gt;test HM 76.0 · AUSUC 68.6&lt;br&gt;&lt;b&gt;final model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="250" height="80" as="geometry"/></mxCell><mxCell id="ladder-36" value="+8.70 val HM&lt;br&gt;(vs v5.13 member: 58.42)" style="endArrow=block;html=1;strokeWidth=3;fontSize=11;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ladder-31" target="ladder-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="